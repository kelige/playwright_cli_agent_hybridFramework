  "properties": {
    "script_id": {
      "type": "string",
      "format": "uuid"
    },
    "script_code": {
      "type": "string"
    },
    "version": {
      "type": "integer"
    },
    "state": {
      "type": "string"
    },
    "processing_run_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "script_id",
    "script_code",
    "version",
    "state",
    "processing_run_id"
  ],
  "additionalProperties": true
}