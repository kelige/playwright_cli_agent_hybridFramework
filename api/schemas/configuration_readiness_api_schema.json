{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "configuration_readiness (GET response)",
  "description": "Generated from a live authenticated response captured on the harish tenant. Required fields are those present on every sampled object; additional properties are allowed.",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string"
    },
    "ready": {
      "type": "boolean"
    },
    "session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ],
      "additionalProperties": true
    },
    "paper_count": {
      "type": "integer"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "critical_alerts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "decision",
    "ready",
    "session",
    "paper_count",
    "issues",
    "critical_alerts"
  ],
  "additionalProperties": true
}