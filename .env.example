# DVS ENVIRONMENT
APP_ENV=staging
DVS_ENV=staging

# PLATFORM ADMIN (control plane — creates universities before the tenant workflow)
PLATFORM_URL=
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
# Shared domain used to derive a new tenant URL, e.g. 35-200-205-253.sslip.io
PLATFORM_BASE_DOMAIN=
PLATFORM_API_BASE_URL=
# How long the live university provisioning step may take (milliseconds)
PLATFORM_PROVISION_TIMEOUT_MS=900000

# MANY UNIVERSITIES (npm run test:matrix)
# How many universities to provision and drive, and how many at the same time.
DVS_MATRIX_COUNT=100
DVS_MATRIX_CONCURRENCY=10
# Report failures without failing the command (--allow-failures sets this too).
DVS_MATRIX_ALLOW_FAILURES=false
# Headed evaluation after the parallel setup (--evaluate), and skip the four
# deliberately-failing checks (--fast).
DVS_MATRIX_EVALUATE=false
DVS_MATRIX_FAST=false
# Keep logs/Playwright/run-state for debugging (--keep-files).
DVS_MATRIX_KEEP_FILES=false
# How long submission retries while marks finish saving.
DVS_MARKS_SAVE_WAIT_MS=20000

# NEW UNIVERSITY (reference values for the live provisioning form)
DVS_UNIVERSITY_NAME=
DVS_UNIVERSITY_CODE=
DVS_UNIVERSITY_ADMIN_EMAIL=
DVS_UNIVERSITY_ADMIN_PASSWORD=

# State-changing workflow gate (provisioning, memberships, policy writes)
DVS_ALLOW_WRITES=false

# WEB APPLICATION (per university; all three point to the same tenant)
WEB_APP_URL=
DVS_WEB_BASE_URL=
DVS_BASE_URL=

# ADMIN LOGIN
DVS_ADMIN_EMAIL=
# Tenant name rendered in the authenticated shell banner.
DVS_TENANT_NAME=
# Handover temporary password for the first-login password-set flow.
DVS_ADMIN_TEMP_PASSWORD=
# Current password (equals the temporary password until first login is completed).
DVS_ADMIN_PASSWORD=
# Opt-in check that a consumed temporary password is rejected (adds one failed login).
DVS_VERIFY_TEMP_REUSE=false

# ROLE LOGINS (populated at runtime after provisioning)
DVS_CHAIRMAN_EMAIL=
DVS_CHAIRMAN_PASSWORD=
DVS_CHIEF_EMAIL=
DVS_CHIEF_PASSWORD=
DVS_EVALUATOR_EMAIL=
DVS_EVALUATOR_PASSWORD=
DVS_SCANNER_EMAIL=
DVS_SCANNER_PASSWORD=
DVS_USER_MANAGER_EMAIL=
DVS_USER_MANAGER_PASSWORD=

# Standard test password applied after a role's first-login password change
DVS_ROLE_NEW_PASSWORD=

# API CONFIGURATION
DVS_API_BASE_URL=
DVS_API_LOGIN_PATH=/api/v1/auth/login
DVS_API_CATALOG_PATH=/api/v1/configuration/catalog
DVS_TENANT_ID=
DVS_API_AUTH_MODE=cookie_session
DVS_API_TOKEN=

# DATABASE (PostgreSQL unverified; SQLite snapshot is the verified reference)
DB_ENGINE=postgresql
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SQLITE_PATH=prompts/db.sqlite3
DB_READ_ONLY=true

# PLAYWRIGHT
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_EXPECT_TIMEOUT=10000
PLAYWRIGHT_EVIDENCE_DIR=test-results/evidence

# LIVE WORKFLOW (npm run workflow)
# How long the headed browser waits for a human to finish face enrollment/capture.
FACE_ENROLLMENT_TIMEOUT_MS=0
# Optional geolocation for the evaluator's mandatory location check
DVS_GEO_LATITUDE=12.9716
DVS_GEO_LONGITUDE=77.5946
