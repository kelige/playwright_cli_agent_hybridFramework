{
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "allure-playwright": "^3.14.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "luxon": "^3.7.2",
    "pg": "^8.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "node scripts/run-test.mjs",
    "test:all": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:smoke:headed": "playwright test --grep @smoke --headed",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:master": "playwright test --grep @master",
    "test:master:headed": "playwright test --grep @master --headed",
    "test:web": "playwright test --project=chromium",
    "test:first-login": "playwright test --project=first-login",
    "test:api": "playwright test --project=api --project=workflow-api --project=testcases-api --grep @api --workers=1",
    "test:platform": "node scripts/run-platform.mjs",
    "test:matrix": "node scripts/run-university-matrix.mjs",
    "test:matrix:failures": "node scripts/run-university-matrix.mjs --allow-failures",
    "test:platform-100": "node scripts/run-university-matrix.mjs --count=100",
    "test:platform-200": "node scripts/run-university-matrix.mjs --count=200",
    "test:platform-500": "node scripts/run-university-matrix.mjs --count=500",
    "test:platform-100:evaluate": "node scripts/run-university-matrix.mjs --count=100 --evaluate",
    "test:platform-200:evaluate": "node scripts/run-university-matrix.mjs --count=200 --evaluate",
    "test:db": "playwright test --project=db --project=testcases-db --grep @db --workers=1",
    "test:db:debug": "playwright test --project=db --grep @db --workers=1 --debug",
    "workflow:all": "npm run test:platform",
    "workflow": "playwright test --project=workflow --workers=1",
    "test:workflow": "playwright test --project=workflow --workers=1",
    "testcases": "node scripts/run-testcases.mjs",
    "testcases:report": "node scripts/open-testcases-summary.mjs",
    "testcases:coverage": "node scripts/testcase-coverage.mjs",
    "testcases:coverage:strict": "node scripts/testcase-coverage.mjs --require-complete",
    "test:testcases": "node scripts/run-testcases.mjs",
    "test:testcases:headed": "node scripts/run-testcases.mjs --headed",
    "test:datadriven": "playwright test --project=chromium --grep @datadriven",
    "testcases:workbook": "node scripts/build-testcase-workbook.mjs",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report reports",
    "summary": "node scripts/open-summary.mjs",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test:sanity:debug": "playwright test --grep @sanity --debug"
  }
  
}
