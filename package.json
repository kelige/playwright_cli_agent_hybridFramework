{
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@faker-js/faker": "^10.6.0",
    "ajv": "^8.20.0",
    "allure-playwright": "^3.14.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "luxon": "^3.7.2",
    "pg": "^8.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "playwright test",
    "test:master": "playwright test --grep @master",
    "test:smoke": "playwright test --grep @smoke",
    "test:web": "playwright test --grep @web",
    "test:first-login": "playwright test --project=first-login",
    "test:api": "playwright test --project=api --grep @api --workers=1",
    "test:db": "playwright test --grep @db",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report reports",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report"
  }
}
